#!/bin/sh
# `vim` always launches plain terminal nvim now, regardless of Neovide —
# `nvim` is the one that pops out Neovide (see bin/executable_nvim). Has to
# resolve the real nvim binary directly rather than `exec nvim`: since
# executable_nvim now shadows plain `nvim` on PATH with the
# Neovide-launcher, a bare `exec nvim` here would loop back into that
# instead of running in the terminal.
#
# This has to be a real executable on PATH, not a shell function/alias:
# programs that shell out to $EDITOR/$VISUAL (git commit, crontab -e, etc.)
# spawn a plain subshell, which inherits PATH but not shell functions.

real_nvim=""
IFS=:
for dir in $PATH; do
  if [ "$dir" != "$HOME/bin" ] && [ -x "$dir/nvim" ]; then
    real_nvim="$dir/nvim"
    break
  fi
done
unset IFS

exec "${real_nvim:-nvim}" "$@"
