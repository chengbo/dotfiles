[user]
	signingkey = ssh-rsa 
	name = Bo Cheng
	email = chengbo1983@gmail.com

[gpg]
	format = ssh

[gpg "ssh"]
{{- if eq .chezmoi.os "linux" }}
	program = "/mnt/c/Users/BoCheng/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
{{- end }}
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers

[commit]
	gpgsign = true

[push]
	autoSetupRemote = true

[core]
	hooksPath = {{ .chezmoi.homeDir }}/.githooks
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore
    pager = delta
[includeIf "gitdir:~/tmo/"]
	path = ~/.gitconfig-tmo

[merge]
    conflictStyle = zdiff3

[alias]
    cleanup = "!~/.scripts/git-cleanup"

[delta]
    navigate = true
	minus-style = red
	plus-style = green
	minus-emph-style = "red \"#4a1018\""
	plus-emph-style = "green \"#1f5a2a\""
	minus-non-emph-style = red
	plus-non-emph-style = green
	keep-plus-minus-markers = true
	zero-style = normal
    line-numbers = true
