#!/bin/sh
# On WSL with Neovide installed on the Windows side, launch that instead of
# the terminal nvim; --wsl makes it spawn nvim inside WSL and just render
# the GUI on Windows. Falls back to plain nvim elsewhere (e.g. macOS).
#
# This has to be a real executable on PATH, not a shell function/alias:
# programs that shell out to $EDITOR/$VISUAL (git commit, crontab -e, etc.)
# spawn a plain subshell, which inherits PATH but not shell functions.
#
# Since this script itself is named `nvim` and sits ahead of the real
# binary on PATH, it can't resolve "the real nvim" via a plain PATH lookup
# — that would just find itself again. Skip $HOME/bin explicitly instead.

real_nvim=""
IFS=:
for dir in $PATH; do
  if [ "$dir" != "$HOME/bin" ] && [ -x "$dir/nvim" ]; then
    real_nvim="$dir/nvim"
    break
  fi
done
unset IFS
: "${real_nvim:=nvim}"

neovide="/mnt/c/Program Files/Neovide/neovide.exe"

# Tools that host their own embedded nvim editor (e.g. Codex's Ctrl+G) invoke
# `nvim --embed` to speak nvim's msgpack-rpc protocol directly over stdio.
# That can't be satisfied by popping out a separate GUI window (and Neovide's
# own arg parser rejects a bare --embed anyway), so fall through to the real
# nvim binary whenever it's present.
for arg in "$@"; do
  if [ "$arg" = "--embed" ]; then
    exec "$real_nvim" "$@"
  fi
done

if [ -x "$neovide" ]; then
  # Neovide's --wsl invocation doesn't source .zshrc, so plain `nvim` on
  # PATH (added there) wouldn't be found — resolve the absolute path here
  # instead and pass it via --neovim-bin.
  # Files must be given as Neovide's own FILES_TO_OPEN args, not after --
  # as raw NEOVIM_ARGS: the latter left Neovide's own default empty
  # buffer as the focused tab, with the real file opened-but-unfocused
  # in a second tab (visible as "[No Name]" + "COMMIT_EDITMSG" in the
  # buftabline during `git commit`).
  # No --fork: block until closed, since callers like `git commit` need to
  # wait for the edit to finish.
  exec "$neovide" --wsl --neovim-bin "$real_nvim" "$@"
else
  exec "$real_nvim" "$@"
fi
